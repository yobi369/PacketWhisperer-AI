# Firebase web app configuration (public client identifiers, not secrets)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# reCAPTCHA Enterprise site key registered for this web app in Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only: true enables the Firebase App Check debug token.
# Register the generated token in Firebase Console > App Check > Manage debug tokens.
VITE_APPCHECK_DEBUG=true
