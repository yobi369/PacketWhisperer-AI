rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/investigations/{investigationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "question", "answer", "inferenceSource", "inferenceMode",
          "evidenceHash", "findingCount", "createdAt"
        ])
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 2000
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 12000
        && request.resource.data.inferenceSource in ["ON_DEVICE", "IN_CLOUD", "UNKNOWN"]
        && request.resource.data.inferenceMode in ["only_on_device", "prefer_on_device"]
        && request.resource.data.evidenceHash is string
        && request.resource.data.evidenceHash.size() <= 64
        && request.resource.data.findingCount is int
        && request.resource.data.findingCount >= 0
        && request.resource.data.findingCount <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
